# systemd EnvironmentFile 示例（NAME=value 格式，禁止使用 bash export 语法）。
# 部署到 /home/octo/.octo/web.env 并设置权限：chmod 600 /home/octo/.octo/web.env

OCTO_WEB_HOST=127.0.0.1
OCTO_WEB_PORT=18300
OCTO_WEB_CWD=/home/octo/workspace
OCTO_WEB_GRACEFUL_TIMEOUT=15

# 第二阶段启用 HTTPS 反向代理时，填入真实外部 Origin（多个用英文逗号分隔）：
# OCTO_WEB_ALLOWED_ORIGINS=https://octo.example.com
# OCTO_WEB_TRUSTED_PROXIES=127.0.0.1,::1

# 从原 model.env 抄录实际使用的模型凭据与接口变量，勿直接把 model.env 当 EnvironmentFile：
# DEEPSEEK_API_KEY=REPLACE_WITH_REAL_KEY
